---
import '@fontsource/inter';
import '../styles/global.css';

interface Props {
	title: string;
    description?: string;
}

const { title, description = "Mi Portafolio Universitario" } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-uia-blue-dark text-slate-100 font-sans antialiased selection:bg-uia-gold selection:text-black">
        <!-- Background Pattern -->
        <div class="fixed inset-0 -z-10 h-full w-full bg-uia-blue-dark">
            <div class="absolute inset-0 bg-[url('/diamond-pattern.svg')] opacity-20 bg-repeat"></div>
            <!-- Fallback/CSS Pattern if SVG not used directly, using CSS grid/radial for tech look -->
            <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255, 215, 0, 0.1) 1px, transparent 1px); background-size: 40px 40px;"></div>
        </div>
		
        <header class="fixed top-0 w-full z-50 border-b border-white/5 bg-uia-blue-dark/80 backdrop-blur-xl">
            <nav class="container mx-auto px-6 h-16 flex items-center justify-between">
                <a href="/" class="text-xl font-bold bg-gradient-to-r from-uia-gold via-yellow-200 to-white bg-clip-text text-transparent">
                    Portafolio
                </a>
                <div class="flex gap-6 text-sm font-medium text-gray-400">
                    <a href="https://portfoliomiguel2025.netlify.app/" target="_blank" rel="noopener noreferrer" class="hover:text-uia-gold transition-colors">Sobre mí</a>
                    <a href="#projects" class="hover:text-uia-gold transition-colors">Proyectos</a>
                    <a href="#tech" class="hover:text-uia-gold transition-colors">Tecnologías</a>
                    <a href="#curriculum" class="hover:text-uia-gold transition-colors">Plan de Estudios</a>
                </div>
            </nav>
        </header>

		<main class="container mx-auto px-6 pt-28 pb-12 min-h-screen animate-fade-in">
			<slot />
		</main>

        <footer class="border-t border-white/10 py-8 text-center text-sm text-gray-500">
            <p>&copy; {new Date().getFullYear()} Portafolio Universitario. Construido con Astro.</p>
        </footer>
	</body>
</html>

<style>
    @keyframes fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fade-in 0.5s ease-out forwards;
    }
</style>
