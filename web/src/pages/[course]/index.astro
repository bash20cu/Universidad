---
import Layout from '../../layouts/Layout.astro';
import { getCourses, getCourseContent } from '../../utils/content';

export function getStaticPaths() {
    const courses = getCourses();
    return courses.map(course => ({
        params: { course: course.path },
        props: { course },
    }));
}

const { course } = Astro.props;
const content = getCourseContent(course.path);

// Sort content: Directories first, then files
content.sort((a, b) => {
    if (a.type === b.type) return a.name.localeCompare(b.name);
    return a.type === 'directory' ? -1 : 1;
});
---

<Layout title={`${course.name} - Portafolio Universitario`}>
    <div class="mb-8 flex items-center gap-4 animate-fade-in">
        <a href="/" class="p-2 rounded-full hover:bg-white/10 text-gray-400 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
        </a>
        <h1 class="text-3xl md:text-5xl font-bold text-white">
            {course.name}
        </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 animate-fade-in" style="animation-delay: 0.1s">
        {content.length === 0 ? (
            <p class="text-gray-500 col-span-full text-center py-12">No hay contenido visible en esta carpeta.</p>
        ) : (
            content.map((item) => (
                <a 
                    href={`https://github.com/tu-usuario/Universidad/tree/master/${course.path}/${item.name}`} 
                    target="_blank"
                    class="group flex items-center p-4 bg-slate-900/30 border border-white/5 rounded-xl hover:bg-slate-800/50 hover:border-blue-500/30 transition-all hover:translate-x-1"
                >
                    <div class={`p-3 rounded-lg mr-4 ${item.type === 'directory' ? 'bg-blue-500/10 text-blue-400' : 'bg-purple-500/10 text-purple-400'}`}>
                        {item.type === 'directory' ? (
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                            </svg>
                        ) : (
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        )}
                    </div>
                    <div>
                        <h3 class="font-medium text-gray-200 group-hover:text-white transition-colors truncate max-w-[200px]" title={item.name}>
                            {item.name}
                        </h3>
                        <p class="text-xs text-gray-500 capitalize">
                            {item.type === 'directory' ? 'Carpeta' : 'Archivo'}
                        </p>
                    </div>
                    <div class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity text-gray-500">
                         <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                    </div>
                </a>
            ))
        )}
    </div>
</Layout>
