---
import Layout from '../../layouts/Layout.astro';
// Rebuild trigger: Added Services_Control README
import { getCourses, getCourseContent, getReadmeContent } from '../../utils/content';
import { marked } from 'marked';
import path from 'node:path';

export function getStaticPaths() {
    const courses = getCourses();
    const paths = [];

    courses.forEach(course => {
        const contents = getCourseContent(course.path);
        contents.forEach(item => {
            if (item.type === 'directory' && item.hasReadme) {
                paths.push({
                    params: { course: course.path, project: item.name },
                    props: { course, project: item }
                });
            }
        });
    });

    return paths;
}

const { course, project } = Astro.props;
// project.path contains something like "CourseName/ProjectName"
const readmeContent = getReadmeContent(path.join(course.path, project.name));
let readmeHtml = '';

if (readmeContent) {
    readmeHtml = await marked.parse(readmeContent);
}

const githubUrl = `https://github.com/bash20cu/Universidad/tree/master/${course.path}/${project.name}`;
---

<Layout title={`${project.name} - ${course.name}`}>
    <div class="mb-6 animate-fade-in">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-4">
            <a href="/" class="hover:text-blue-400 transition-colors">Inicio</a>
            <span>/</span>
            <a href={`/${course.path}`} class="hover:text-blue-400 transition-colors">{course.name}</a>
            <span>/</span>
            <span class="text-white">{project.name}</span>
        </div>
    </div>

    <div class="max-w-4xl mx-auto">
        <div class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 border border-white/10 rounded-2xl p-8 mb-8 backdrop-blur-sm animate-fade-in">
            <div class="flex justify-between items-start">
                <div>
                     <h1 class="text-3xl md:text-4xl font-bold text-white mb-2">{project.name}</h1>
                     <p class="text-gray-400">Proyecto de {course.name}</p>
                </div>
                <a href={githubUrl} target="_blank" class="flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors text-sm font-medium border border-white/10">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.337-3.369-1.337-.454-1.154-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.597 1.028 2.688 0 3.848-2.339 4.685-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
                    </svg>
                    Ver en GitHub
                </a>
            </div>
        </div>

        <article class="prose prose-invert prose-lg max-w-none w-full
            prose-headings:text-blue-100 prose-a:text-blue-400 hover:prose-a:text-blue-300
            prose-pre:bg-[#1e1e1e] prose-pre:border prose-pre:border-white/10 prose-pre:overflow-x-auto
            prose-img:rounded-xl prose-img:shadow-lg prose-img:max-w-full
            break-words overflow-hidden
            bg-slate-900/40 p-8 rounded-3xl border border-white/5 animate-fade-in" style="animation-delay: 0.1s">
            {readmeHtml ? <Fragment set:html={readmeHtml} /> : (
                <div class="text-center py-10">
                    <p class="text-gray-500">Este proyecto no tiene un README detallado. Puedes ver el código fuente en GitHub.</p>
                </div>
            )}
        </article>
    </div>
</Layout>
