---
import Layout from '../layouts/Layout.astro';
import { getCourses } from '../utils/content';

const courses = getCourses();
---

<Layout title="Mi Portafolio Universitario">
    <section class="flex flex-col items-center justify-center py-20 text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-blue-500/10 blur-[100px] rounded-full -z-10 transform scale-50"></div>
        
        <h1 class="text-5xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 bg-clip-text text-transparent pb-2 animate-fade-in">
            Portafolio Universitario
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mb-10 animate-fade-in" style="animation-delay: 0.1s">
            Explorando el conocimiento a través del código. Una colección de proyectos y tareas de mi carrera universitaria.
        </p>
        <div class="flex gap-4 animate-fade-in" style="animation-delay: 0.2s">
            <a href="#courses" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full font-medium transition-all hover:scale-105 shadow-lg shadow-blue-500/25">
                Ver Cursos
            </a>
            <a href="https://github.com/bash20cu" target="_blank" class="px-6 py-3 bg-white/10 hover:bg-white/20 text-white rounded-full font-medium transition-all backdrop-blur-sm border border-white/10">
                GitHub
            </a>
        </div>
    </section>

    <section id="courses" class="py-12 animate-fade-in" style="animation-delay: 0.3s">
        <h2 class="text-3xl font-bold text-white mb-10 border-l-4 border-blue-500 pl-4 flex items-center">
            Cursos y Materias
            <span class="ml-4 text-sm font-normal text-gray-500 bg-gray-900 border border-gray-800 px-3 py-1 rounded-full">
                {courses.length} encontrados
            </span>
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {courses.map((course) => (
                <a href={`/${course.path}`} class="group relative bg-slate-900/50 border border-white/10 rounded-2xl p-6 hover:border-blue-500/50 transition-all hover:shadow-xl hover:shadow-blue-500/10 overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-purple-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    
                    <div class="relative z-10">
                        <h3 class="text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors">
                            {course.name}
                        </h3>
                        <p class="text-sm text-gray-400 mb-4">
                            {course.projectCount} {course.projectCount === 1 ? 'proyecto' : 'proyectos'}
                        </p>
                        <div class="flex items-center text-blue-400 text-sm font-medium">
                            Ver contenido
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>
</Layout>
