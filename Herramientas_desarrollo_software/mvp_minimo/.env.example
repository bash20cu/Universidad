APP_HOST=127.0.0.1
APP_PORT=5050
FLASK_DEBUG=0
SECRET_KEY=cambia-esta-clave-en-desarrollo
DATABASE_URL=sqlite:///tutoria.db
COOKIE_SECURE=0
AUTO_OPEN_BROWSER=1

# Usa console para desarrollo local o resend para correo real.
TWO_FACTOR_DELIVERY=resend_console
RESEND_API_KEY=
RESEND_FROM_EMAIL="TutorIA <onboarding@resend.dev>"

FM_COMMAND=/usr/bin/fm
FM_HOST=127.0.0.1
FM_PORT=1976
FM_MODEL=system
FM_START_TIMEOUT=20

# La ubicación del usuario y la del modelo son conceptos independientes.
APP_ACCESS_MODE=local
AI_PROCESSING_LOCATION=device

# NVIDIA es el proveedor principal; Foundation Models queda como fallback local.
AI_PRIMARY_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
