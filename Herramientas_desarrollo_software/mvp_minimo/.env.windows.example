APP_HOST=127.0.0.1
APP_PORT=5050
FLASK_DEBUG=0
SECRET_KEY=cambia-esta-clave-en-desarrollo
DATABASE_URL=sqlite:///tutoria.db
COOKIE_SECURE=0

# Windows utiliza NVIDIA; no requiere Foundation Models ni correo 2FA.
AI_PRIMARY_PROVIDER=nvidia
APP_ACCESS_MODE=remote
AI_PROCESSING_LOCATION=remote
NVIDIA_API_KEY=pega-aqui-tu-clave-de-NVIDIA
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Se conservan para que la configuracion sea compatible, pero no se usa email.
TWO_FACTOR_DELIVERY=console

# En Windows no se ejecuta fm serve.
FM_COMMAND=fm-no-disponible-en-windows
FM_HOST=127.0.0.1
FM_PORT=1976
FM_MODEL=system
